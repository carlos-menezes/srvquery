{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "@internal/typescript-config/base.tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "declarationDir": "./dist",
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "paths": {
      "#utils/*": ["./src/util/*"],
      "#network/*": ["./src/net/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
